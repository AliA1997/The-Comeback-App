# Copy to .env and fill in. See CLAUDE.md § Key Commands › Environment.
#
# The app reads EXPO_PUBLIC_* at bundle time. For EAS builds these are set per
# profile in artifacts/career-tracker/eas.json, not from this file.

# ---------------------------------------------------------------------------
# Database — lib/db and the API server
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/comeback

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
PORT=3000

# Issuer for Supabase JWT verification. The API fetches the JWKS from
# $SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Only needed for legacy projects that still sign tokens with HS256.
# SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Expo app
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
